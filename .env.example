SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/escapa_db
SPRING_DATASOURCE_USERNAME=escapa
SPRING_DATASOURCE_PASSWORD=escapa123
SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_JWT_SECRET=escapa-jwt-secret-key-development-minimum-256-bits-length
APP_JWT_EXPIRATION_MINUTES=60
APP_SEAT_PRICE=79.00
APP_INVITE_EXPIRATION_HOURS=72

# E-mail (US-31). Estes valores sao lidos pelo docker compose: o padrao e o Mailpit
# (caixa de entrada em http://localhost:8025). Para envio real em dev, troque host, porta,
# usuario e senha pelos do seu SMTP, ligue APP_MAIL_AUTH e APP_MAIL_STARTTLS e mantenha
# APP_MAIL_TEST_MODE=true. Nunca commite credenciais reais: o .env fica fora do git.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_AUTH=false
APP_MAIL_STARTTLS=false
APP_MAIL_FROM=nao-responda@escapa.com.br
APP_MAIL_TEST_MODE=true
# Opcional: em modo de teste, envia todos os e-mails para este endereco (ex.: o seu).
APP_MAIL_TEST_REDIRECT_TO=
APP_FRONTEND_URL=http://localhost:3000
