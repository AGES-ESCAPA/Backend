# Configuracao local do backend. Copie para .env (ignorado pelo git) e ajuste so o
# que for diferente do padrao. Para rodar localmente, nada precisa mudar.
#
# Quem le este arquivo:
#   - Docker Compose: sempre (usa SERVER_PORT e POSTGRES_HOST_PORT no docker-compose.yml).
#   - Spring Boot: no perfil dev (mvn spring-boot:run), via spring.config.import.
#     Fora de dev (jar, homologacao, producao) so variaveis de ambiente valem.
#   - Variavel exportada no terminal tem prioridade sobre este arquivo.

# Porta do backend na sua maquina, tanto pelo Maven quanto pelo Docker.
# Se estiver ocupada, o perfil dev tenta 8081, 8082, 8083 sozinho.
SERVER_PORT=8080

# Porta do container do Postgres na sua maquina. 15432 evita conflito com PostgreSQL
# instalado no sistema (os instaladores usam 5432, 5433, 5434...).
POSTGRES_HOST_PORT=15432

# Credenciais do banco. Iguais as do docker-compose.yml.
SPRING_DATASOURCE_USERNAME=escapa
SPRING_DATASOURCE_PASSWORD=escapa123
# So se o banco NAO for o container acima (a URL padrao ja usa POSTGRES_HOST_PORT):
# SPRING_DATASOURCE_URL=jdbc:postgresql://outro-host:5432/escapa_db

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Origem do frontend liberada no CORS (lista separada por virgula).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
