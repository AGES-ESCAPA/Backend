# Variaveis de ambiente do backend.
#
# Quem le este arquivo:
#   - Docker Compose: le .env sozinho e usa POSTGRES_HOST_PORT no docker-compose.yml.
#   - Spring Boot: NAO le .env. Para `mvn spring-boot:run`, exporte as variaveis no
#     terminal (PowerShell: $env:NOME = "valor") ou configure-as na IDE.
#
# Os valores abaixo sao os padroes de application.properties e docker-compose.yml.
# Para rodar localmente nada precisa ser alterado.

# Porta do Postgres exposta para a maquina do dev. 5433 evita conflito com um
# PostgreSQL instalado no sistema (que ocupa a 5432).
POSTGRES_HOST_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/escapa_db
SPRING_DATASOURCE_USERNAME=escapa
SPRING_DATASOURCE_PASSWORD=escapa123
SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
